# ── Database ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://peersphere:peersphere@localhost:5432/peersphere_dev"

# ── JWT ───────────────────────────────────────────────────────────
# REQUIRED, min 32 chars — the app refuses to boot without them.
# Generate each with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# ── File upload ───────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5

# ── Rate limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
