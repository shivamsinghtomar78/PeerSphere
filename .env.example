# ── Database (required) ───────────────────────────────────────────
# Neon: use the POOLED connection string (hostname contains "-pooler"),
# keep ?sslmode=require. Any PostgreSQL 16 works.
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"

# ── JWT (required, min 32 chars — the app refuses to boot without them)
# Generate each with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
# Optional token lifetimes ("15m", "7d", or seconds; defaults shown)
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Optional ──────────────────────────────────────────────────────
# API base for the browser client (defaults to /api/v1 — leave unset)
# NEXT_PUBLIC_API_URL="/api/v1"

# Resume uploads (defaults shown)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5
