# ── Database ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://peersphere:peersphere@localhost:5432/peersphere_dev"

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-random-256-bit-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-to-a-different-random-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# ── File upload ───────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5

# ── Rate limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
